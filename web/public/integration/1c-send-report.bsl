// Шаблон серверного общего модуля 1С:Предприятия 8.3.
// Адаптировать и проверить в тестовой базе вашей конфигурации.
// Сервер: только имя хоста. Ресурс: URL-кодированный путь с параметрами
// /api/integrations/documents?channelId=...&title=...&filename=...&externalId=...&review=1
// Ключ брать из защищённых настроек, не хранить в исходниках.
// Файл заранее сформирован средствами вашей конфигурации в PDF/XLSX/CSV.
Функция ОтправитьОтчетDocspace(Сервер, Ресурс, Ключ, ИмяФайла) Экспорт
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Authorization", "Bearer " + Ключ);
    Заголовки.Вставить("Content-Type", "application/octet-stream");
    Соединение = Новый HTTPСоединение(Сервер, 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
    Запрос.УстановитьТелоИзДвоичныхДанных(Новый ДвоичныеДанные(ИмяФайла));
    Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
    Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 201 Тогда
        ВызватьИсключение "Docspace: HTTP " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

// Ресурс: /api/integrations/documents?externalId=URL_ENCODED_ID
Функция ПолучитьРешениеDocspace(Сервер, Ресурс, Ключ) Экспорт
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Authorization", "Bearer " + Ключ);
    Соединение = Новый HTTPСоединение(Сервер, 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
    Ответ = Соединение.ВызватьHTTPМетод("GET", Запрос);
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Docspace: HTTP " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции
