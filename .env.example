# Local browser demo: no MAX token required.
DEMO_MODE=true
LISTEN_ADDR=127.0.0.1:8080
# Docker host port. Set 8083 if local :8080 is already running.
DOCSPACE_PORT=8080
MAX_BOT_TOKEN=

# Used when migrating an older single-workspace live dataset.
MAX_MANAGER_IDS=
MAX_MEMBER_IDS=

# Set after organizers bind the mini app to this bot.
PUBLIC_APP_URL=

# off | polling | webhook
BOT_MODE=off
MAX_WEBHOOK_SECRET=
MAX_API_URL=https://platform-api2.max.ru
MAX_CA_FILE=certs/russian_trusted_root_ca.crt

# Optional isolated PostgreSQL/ETL profile for the reference dataset.
REFERENCE_DB_NAME=max_business
REFERENCE_DB_USER=postgres
REFERENCE_DB_PASSWORD=local-reference-only
REFERENCE_DB_PORT=5433

# Accounting Systems QA & Mock Runner (Ozon Tech)
ACCOUNTING_QA_PORT=8081
DOCSPACE_TEST_INTEGRATION_TOKEN=

