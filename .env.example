# ==============================================================================
# Переменные окружения для запуска проекта (Платформа MAX - Эффективный бизнес)
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# ==============================================================================

# База данных PostgreSQL
POSTGRES_DB=max_business
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_password
POSTGRES_PORT=5432

# Строка подключения для бэкенда/приложений
DATABASE_URL=postgresql://postgres:postgres_secret_password@localhost:5432/max_business

# Настройки платформы MAX (токен бота выдается организаторами)
MAX_BOT_TOKEN=your_bot_token_here
MAX_API_BASE_URL=https://platform-api2.max.ru
